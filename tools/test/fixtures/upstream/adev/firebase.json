{
  "hosting": {
    "target": "angular-docs",
    "public": "./build/browser",
    "ignore": ["**/.*"],
    "trailingSlash": false,
    "headers": [
      {
        "source": "**",
        "headers": [
          {"key": "Cross-Origin-Opener-Policy", "value": "same-origin"},
          {"key": "Cross-Origin-Embedder-Policy", "value": "require-corp"}
        ]
      }
    ],
    "rewrites": [{"source": "**", "destination": "/index.html"}]
  }
}
